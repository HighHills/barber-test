# =======================================================
# BARBERSHOP OPERATING SYSTEM — ENVIRONMENT VARIABLES
# Architecture: 1 Business = 1 Database Instance
# =======================================================

# Web build: set these two values per customer. Both are public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-project-key
MOBILE_ACTIVATION_SECRET=generate-a-random-secret-of-at-least-32-characters

# Operator-only provisioning: SUPABASE_SECRET_KEY must be supplied via a
# private environment/secret manager, never copied into web or APK configs.

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
# APK baru tidak memerlukan EXPO_PUBLIC_SUPABASE_*; aktivasi dilakukan dari web.

# Default Deployment Localization
DEFAULT_CURRENCY=IDR
DEFAULT_TIMEZONE=Asia/Jakarta
